# Скопируйте в .env рядом с compose.yml (chmod 600) и заполните. .env в git не попадает.
DOMAIN=api.example.com              # домен, A-запись которого указывает на этот сервер
ACME_EMAIL=you@example.com          # для уведомлений Let's Encrypt

POSTGRES_USER=shoplist
POSTGRES_PASSWORD=                  # openssl rand -hex 24
POSTGRES_DB=shoplist

JWT_SECRET=                         # openssl rand -hex 32

# Нужен, только если в проекте Expo включена защита push-токенов
EXPO_ACCESS_TOKEN=

# Образ сервера (собирается в GitHub Actions) и папка бэкапов
SERVER_IMAGE=ghcr.io/oleg990/shoplist-server:latest
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
