# Скопируйте в .env и поменяйте пароль. .env в git не попадает.
POSTGRES_USER=shoplist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shoplist

# Сервер (в проде обязательно)
APP_ENV=development            # production требует SMTP_*
JWT_SECRET=                    # минимум 32 символа: openssl rand -hex 32
SMTP_HOST=
SMTP_PORT=587                  # порт со STARTTLS
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ShopList <noreply@example.com>
